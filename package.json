{
  "name": "@fean-developer/devvault-cli",
  "version": "1.0.27",
  "publisher": "fean-developer",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vault",
    "cli",
    "devvault",
    "devops",
    "docker",
    "docker-compose",
    ".env",
    "variables",
    "secrets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fean-developer/devvault.git"
  },
  "homepage": "https://github.com/fean-developer/devvault#readme",
  "bugs": {
    "url": "https://github.com/fean-developer/devvault/issues"
  },
  "discussion": {
    "url": "https://github.com/fean-developer/devvault/discussions"
  },
  "scripts": {
    "build": "corepack pnpm --recursive build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation:test": "node scripts/phase0-mutation-sensor.mjs",
    "prepare:npm": "corepack pnpm build && node scripts/prepare-npm-package.mjs",
    "corepack:npm": "corepack pnpm prepare:npm",
    "verify:npm-package": "node scripts/verify-npm-package.mjs",
    "package:npm": "corepack pnpm prepare:npm && node scripts/verify-npm-package.mjs",
    "pack:npm": "corepack pnpm package:npm && npm pack .npm-dist --pack-destination .npm-dist",
    "publish:npm": "corepack pnpm package:npm && npm publish .npm-dist --access public --tag alpha"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}